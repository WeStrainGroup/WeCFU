{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WeCFU",
  "version": "1.3.0-rc.1",
  "identifier": "org.westraingroup.wecfu",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'",
      "capabilities": [
        {
          "identifier": "bootstrap",
          "windows": [
            "main"
          ],
          "permissions": ["allow-boot-status"],
          "local": true
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../bundle/": "bundle/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Count, review and export colony observations locally."
  }
}
